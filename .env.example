# Local mode (the default) needs none of this - just run:
#   go build . && ./coc-progress -snapshot village.json
#
# Setting DATABASE_URL switches to hosted mode: accounts, Postgres-backed
# history, per-user quotas. Meant for a Vercel deployment, not a laptop.
# Copy this file to .env.local (or set these in the Vercel dashboard) and
# fill in real values - every one of them is required once DATABASE_URL is set.

# Postgres connection string. Use a transaction-pooling endpoint (e.g.
# Neon's "-pooler" host) - a serverless function opens a fresh pool per
# instance, and a session-pooling or direct connection runs out fast.
DATABASE_URL=postgres://user:password@host-pooler.neon.tech/dbname?sslmode=require

# This deployment's own origin, no trailing slash. Used to build OAuth
# redirect URLs and to validate CORS/Origin on state-changing requests.
BASE_URL=https://your-deployment.vercel.app

# At least one of GitHub or Google must be set, or the server refuses to
# start in hosted mode. Register an OAuth app at
# https://github.com/settings/developers (GitHub) or
# https://console.cloud.google.com/apis/credentials (Google); the callback
# URL is {BASE_URL}/api/auth/github/callback or .../google/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bearer token the daily cron job (vercel.json) must present to
# /api/cron/prune to delete snapshots older than 14 days. Generate one with:
#   openssl rand -base64 32
CRON_SECRET=
